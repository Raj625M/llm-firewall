# Copy this file to ".env" and fill in your values. Never commit .env to GitHub.
#
# Any provider with an OpenAI-compatible API works. Two with free tiers
# (check their sites for current limits and model names):
#
# Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=<a model name from Groq's model list, e.g. a Llama 3.x model>
#
# Google Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=<a model name from Gemini's model list>

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste-your-key-here
LLM_MODEL=paste-a-model-name-here
